<!-- The GitHub webhook receiver (github.md) as the CircagraphGitHub Windows service, run
     by WinSW (circagraph-github-service.exe, beside this file) as circagraph-service.xml
     runs the server: Node.js runs the receiver with github.env in ProgramData, as the
     LocalService account. Setup installs it to start by hand, since it needs an API key, the
     webhook's secret and routes first (README.Windows.txt); it may send to a server elsewhere,
     so it does not depend on the Circagraph service. -->
<service>
  <id>CircagraphGitHub</id>
  <name>Circagraph GitHub receiver</name>
  <description>Receives GitHub webhooks on 127.0.0.1:5580 into Circagraph timelines.</description>
  <executable>%BASE%\..\node\node.exe</executable>
  <arguments>"%BASE%\..\app\server\github-receiver.mjs"</arguments>
  <workingdirectory>%BASE%\..\app</workingdirectory>
  <env name="OCH_CONFIG" value="%ProgramData%\Circagraph\github.env"/>
  <env name="NODE_ENV" value="production"/>
  <startmode>Manual</startmode>
  <onfailure action="restart" delay="10 sec"/>
  <resetfailure>1 hour</resetfailure>
  <!-- Stopping sends Ctrl+C: the receiver saves what is queued, waiting up to ten seconds. -->
  <stoptimeout>15 sec</stoptimeout>
  <logpath>%ProgramData%\Circagraph\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalService</user>
    <allowservicelogon>true</allowservicelogon>
  </serviceaccount>
</service>

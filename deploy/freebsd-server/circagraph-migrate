#!/bin/sh
# Copyright (c) 2026 Athan Clark. SPDX-License-Identifier: GPL-3.0-only
# Brings the Circagraph database up to this package's schema, then (re)starts the server,
# the mail worker and the syslog and GitHub receivers, each when it is enabled (an upgrade
# stopped them all, #371, #374). Safe to run more than once.
# Usage, as root: circagraph-migrate [--no-restart]   (restarts nothing)
set -eu
APP=/usr/local/lib/circagraph
CONFIG=/usr/local/etc/circagraph/circagraph.env
if [ "$(id -u)" -ne 0 ]; then
  echo "Run as root: circagraph-migrate" >&2
  exit 1
fi
if [ ! -r "$CONFIG" ]; then
  echo "$CONFIG is missing; run circagraph-setup, or restore it from a backup." >&2
  exit 1
fi
# As the server's user, the configuration's group: circagraph, or openchronology for an
# installation from before the rename. Node reads the same KEY=value file the services use,
# and as systemd reads it (OCH_CONFIG: a # inside a value is part of it, #118).
user=$(stat -L -f %Sg "$CONFIG")
cd /
su -m "$user" -c "env OCH_CONFIG=$CONFIG /usr/local/bin/node $APP/server/migrate.mjs"
if [ "${1:-}" != "--no-restart" ] && service circagraph enabled; then
  service circagraph restart >/dev/null 2>&1 || service circagraph start >/dev/null
  echo "Circagraph restarted."
fi
[ "${1:-}" = "--no-restart" ] && exit 0
for worker in "mail:mail worker" "syslog:syslog receiver" "github:GitHub receiver"; do
  name="circagraph_${worker%%:*}"
  if service "$name" enabled; then
    service "$name" restart >/dev/null 2>&1 || service "$name" start >/dev/null
    echo "Circagraph ${worker#*:} restarted."
  fi
done

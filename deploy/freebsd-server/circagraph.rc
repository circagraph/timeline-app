#!/bin/sh
# Copyright (c) 2026 Athan Clark. SPDX-License-Identifier: GPL-3.0-only
#
# PROVIDE: circagraph
# REQUIRE: LOGIN postgresql
# KEYWORD: shutdown
#
# The Circagraph platform, on 127.0.0.1:5173. Enable it in /etc/rc.conf with sysrc circagraph_enable=YES (circagraph-setup does).
# Its configuration is /usr/local/etc/circagraph/circagraph.env (or circagraph_config). It runs as
# the circagraph user, or circagraph_account: openchronology for an installation from before the
# rename, which circagraph-setup sets.

. /etc/rc.subr

name=circagraph
rcvar=circagraph_enable
load_rc_config $name

: ${circagraph_enable:="NO"}
: ${circagraph_config:="/usr/local/etc/circagraph/circagraph.env"}
# Not circagraph_user: rc.subr would run daemon(8) itself as that user.
: ${circagraph_account:="circagraph"}

# daemon(8) runs it as the server's user, restarts it if it fails and sends its
# output to syslog, holding nothing open of the terminal or script that started it (-f).
# Its configuration is read as systemd reads it (OCH_CONFIG, #118).
pidfile="/var/run/circagraph/circagraph.pid"
procname="daemon"
command="/usr/sbin/daemon"
command_args="-f -r -S -T circagraph -P ${pidfile} -u ${circagraph_account} /usr/bin/env NODE_ENV=production OCH_CONFIG=${circagraph_config} /usr/local/bin/node /usr/local/lib/circagraph/circagraph-server.mjs"
circagraph_chdir="/usr/local/lib/circagraph"
start_precmd="circagraph_prestart"

circagraph_prestart()
{
	# Root's: in a folder of the service's user, it could replace daemon(8)'s pidfile and have
	# stop signal another process.
	install -d -o root -g wheel -m 0755 /var/run/circagraph
}

run_rc_command "$1"

#!/bin/sh
# Copyright (c) 2026 Athan Clark. SPDX-License-Identifier: GPL-3.0-only
# Sets up Circagraph after Homebrew installs it (#116), as the other packages' setup does:
# the configuration, PostgreSQL @PG_MAJOR@ (started with brew services when it is not running),
# the database with pgmp, the migration and the circagraph-server service. Homebrew's
# PostgreSQL runs as you, so the server does too; it connects to the database as the
# circagraph role, which owns it but is not a superuser as you are there, as the other
# packages' servers do. An installation that has its configuration
# and database already (an upgrade) is left alone, with advice. Safe to run again.
# An installation of openchronology-server (the formula's name until 0.30) keeps its database
# and role, which its configuration names; its configuration moves from etc/openchronology to
# etc/circagraph, as the formula's post_install moves it, and a link stays behind.
# Usage: circagraph-setup
set -e
PREFIX=@HOMEBREW_PREFIX@
CONFIG_DIR=$PREFIX/etc/circagraph
CONFIG=$CONFIG_DIR/circagraph.env
EXAMPLES=$PREFIX/share/circagraph
PG=@PG_BIN@
BREW=$PREFIX/bin/brew
DOCS=$PREFIX/share/doc/circagraph-server/README.Homebrew
if [ "$(id -u)" -eq 0 ]; then
  echo "Run circagraph-setup as yourself, not root: Homebrew's PostgreSQL runs as you." >&2
  exit 1
fi

# From openchronology-server: its configuration, under the new names.
OLD_CONFIG_DIR=$PREFIX/etc/openchronology
if [ -d "$OLD_CONFIG_DIR" ] && [ ! -L "$OLD_CONFIG_DIR" ] && [ ! -e "$CONFIG_DIR" ]; then
  mv "$OLD_CONFIG_DIR" "$CONFIG_DIR"
  ln -s circagraph "$OLD_CONFIG_DIR"
fi
if [ -f "$CONFIG_DIR/openchronology.env" ] && [ ! -L "$CONFIG_DIR/openchronology.env" ] &&
  [ ! -e "$CONFIG" ]; then
  mv "$CONFIG_DIR/openchronology.env" "$CONFIG"
  ln -s circagraph.env "$CONFIG_DIR/openchronology.env"
fi

existing=
if [ -e "$CONFIG" ]; then existing=1; fi
# The database and the role the server connects as: those its configuration names, or, for a
# new installation, circagraph.
db=circagraph
role=circagraph
if [ -n "$existing" ]; then
  url=$(sed -n 's/^DATABASE_URL=//p' "$CONFIG" | tail -1)
  configured=$(echo "$url" | sed -n 's|^postgres[a-z]*://[^/]*/\([^?]*\).*|\1|p')
  [ -n "$configured" ] && db=$configured
  role=$(echo "$url" | sed -n 's|^postgres[a-z]*://\([^:@/]*\)[^@/]*@.*|\1|p')
  [ -n "$role" ] || role=$db
fi

mkdir -p "$CONFIG_DIR" "$PREFIX/var/circagraph" "$PREFIX/var/log"
chmod 0700 "$CONFIG_DIR"
# Configuration files are created once and then belong to you: upgrades never rewrite them
# (each version's templates stay in $EXAMPLES to compare).
new_config() {
  [ -e "$1" ] && return 0
  sed "$2" "$3" >"$1.new"
  chmod 0600 "$1.new"
  mv "$1.new" "$1"
}
key=$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')
new_config "$CONFIG" \
  "s|^AUTH_ENCRYPTION_KEY=\$|AUTH_ENCRYPTION_KEY=$key|; s|^DATABASE_URL=.*|DATABASE_URL=postgresql://$role@/$db?host=/tmp|" \
  "$EXAMPLES/circagraph.env.example"
new_config "$CONFIG_DIR/syslog.env" "" "$EXAMPLES/syslog.env.example"
new_config "$CONFIG_DIR/github.env" "" "$EXAMPLES/github.env.example"

# SQL as you, Homebrew's PostgreSQL superuser, over its socket in /tmp.
pg() { "$PG/psql" -X -q -At -v ON_ERROR_STOP=1 -h /tmp -d "$1" -c "$2"; }
reachable() { pg postgres 'SELECT 1' >/dev/null 2>&1; }
if ! reachable; then
  "$BREW" services start postgresql@@PG_MAJOR@ >/dev/null 2>&1 || true
  for _ in $(seq 30); do
    reachable && break
    sleep 1
  done
fi
running=
if reachable; then running=1; fi
# pgmp is built for PostgreSQL @PG_MAJOR@: another version answering on the same socket cannot
# load it.
if [ -n "$running" ]; then
  major=$(pg postgres 'SHOW server_version_num' | cut -c1-2)
  if [ "$major" != @PG_MAJOR@ ]; then
    cat <<MSG >&2

PostgreSQL $major is running on /tmp, port 5432; Circagraph needs PostgreSQL @PG_MAJOR@ there.
Stop the other one (or move it to another port), then run this again:

  brew services stop postgresql@$major
  brew services start postgresql@@PG_MAJOR@
  circagraph-setup

MSG
    exit 1
  fi
fi
installed=
if [ -n "$existing" ] && [ -n "$running" ] &&
  [ -n "$(pg postgres "SELECT 1 FROM pg_database WHERE datname='$db'")" ]; then
  installed=1
fi
if [ -n "$installed" ]; then
  missing=$(sed -n 's/^\([A-Z][A-Z0-9_]*\)=.*/\1/p' "$EXAMPLES/circagraph.env.example" |
    while read -r name; do grep -q "^$name=" "$CONFIG" || echo "  $name"; done)
  cat <<MSG

Circagraph is set up already (its configuration and database are kept). After an
upgrade, the database is migrated to the new version with:

  1. Review the configuration in $CONFIG against this version's template:
       diff -u $CONFIG $EXAMPLES/circagraph.env.example
MSG
  if [ -n "$missing" ]; then
    echo "     New settings to consider (their defaults apply until you add them):"
    echo "$missing" | sed 's/^/     /'
  fi
  cat <<MSG
  2. Back up the database:   $PG/pg_dump -h /tmp $db > $db.sql
  3. Migrate and restart:    circagraph-migrate
MSG
  # What still runs under the names before the rename, until circagraph-migrate moves it.
  agents=$HOME/Library/LaunchAgents
  old_agents=$(ls "$agents/homebrew.mxcl.openchronology-server.plist" \
    "$agents"/org.openchronology.*.plist 2>/dev/null || true)
  if [ -n "$old_agents" ] ||
    launchctl print "gui/$(id -u)/homebrew.mxcl.openchronology-server" >/dev/null 2>&1; then
    cat <<MSG

OpenChronology is now Circagraph: its configuration moved to $CONFIG_DIR, its commands are
circagraph-migrate, circagraph-agent and cg-import-github (the old names still work), and
its service is circagraph-server. circagraph-migrate stops the openchronology-server service
and starts circagraph-server in its place, and moves the mail, syslog and GitHub agents you
started to their new names (org.circagraph.*). The database, $db, keeps its name.
MSG
  fi
  cat <<MSG

See $DOCS.

MSG
  exit 0
fi
if [ -z "$running" ]; then
  cat <<MSG

PostgreSQL @PG_MAJOR@ is not running, so the database was not created. Start it, then run this
again:

  brew services start postgresql@@PG_MAJOR@
  circagraph-setup

See $DOCS.

MSG
  exit 1
fi
# The server's role: it owns the database, and migrates it, without a superuser's rights.
if [ -z "$(pg postgres "SELECT 1 FROM pg_roles WHERE rolname='$role'")" ]; then
  pg postgres "CREATE ROLE \"$role\" LOGIN"
fi
if [ -z "$(pg postgres "SELECT 1 FROM pg_database WHERE datname='$db'")" ]; then
  "$PG/createdb" -h /tmp -O "$role" "$db"
fi
# pgmp is not a trusted extension: you, the superuser, create it once for the server's role.
pg "$db" 'CREATE EXTENSION IF NOT EXISTS pgmp'
"$PREFIX/bin/circagraph-migrate" --no-restart
"$BREW" services restart circagraph-server >/dev/null
origin=$(sed -n 's/^APP_ORIGIN=//p' "$CONFIG")
cat <<MSG

Circagraph is installed and running at $origin.

Next steps:
  - Set APP_ORIGIN, email, an administrator and sign-in providers in $CONFIG,
    then: circagraph-migrate (creates the administrator, and restarts the server)
  - Put an HTTPS reverse proxy in front of it for public use.
  - Back up AUTH_ENCRYPTION_KEY from $CONFIG separately from the database.

See $DOCS.

MSG

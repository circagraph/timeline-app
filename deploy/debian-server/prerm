# Stops the services before removal or an upgrade. After an upgrade the server starts again
# with circagraph-migrate, once the database matches the new version.
set -e
case "$1" in
  remove | upgrade | deconfigure)
    if [ -d /run/systemd/system ]; then
      systemctl stop circagraph.service circagraph-mail.service \
        circagraph-syslog.service circagraph-github.service \
        circagraph-journald.service >/dev/null 2>&1 || true
    fi
    ;;
esac
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
  systemctl disable --quiet circagraph.service circagraph-mail.service \
    circagraph-syslog.service circagraph-github.service \
    circagraph-journald.service >/dev/null 2>&1 || true
fi
exit 0
